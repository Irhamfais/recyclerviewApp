<?xml version="1.0" encoding="utf-8"?>
<!--
    data_extraction_rules.xml — aturan ekstraksi data (Android 12+).
    Menggantikan android:fullBackupContent untuk kontrol backup & cloud storage.
-->
<data-extraction-rules>
    <cloud-backup>
        <!--
            Kecualikan data yang tidak perlu di-backup ke cloud.
            Contoh: <exclude domain="database" path="app_cache.db"/>
        -->
    </cloud-backup>
    <device-transfer>
        <!--
            Aturan saat transfer antar perangkat (misal: fitur "Switch ke Android baru").
        -->
    </device-transfer>
</data-extraction-rules>
