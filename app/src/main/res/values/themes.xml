<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Theme.App — tema utama aplikasi.
        Menggunakan Material3 (Theme.Material3.DayNight) untuk:
          - Dukungan Dark Mode otomatis
          - Komponen Material (CardView, Button, dsb.) yang konsisten
    -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Warna primer yang digunakan Material3 untuk komponen interaktif -->
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>

        <!-- Warna sekunder / aksen -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar mengikuti warna primer -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
