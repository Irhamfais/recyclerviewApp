<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml — layout utama MainActivity.
    Hanya berisi RecyclerView yang mengisi seluruh layar.
    ConstraintLayout sebagai root untuk fleksibilitas pengembangan ke depan.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!--
        RecyclerView mengisi seluruh layar.
        - clipToPadding="false": item tetap terlihat di area padding saat di-scroll
        - paddingVertical="8dp": jarak atas dan bawah agar item pertama/terakhir tidak menempel tepi
    -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
