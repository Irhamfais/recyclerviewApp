<?xml version="1.0" encoding="utf-8"?>
<!--
    item_movie.xml — layout untuk SATU baris item di RecyclerView.
    ViewBinding akan men-generate class 'ItemMovieBinding' dari file ini.

    Struktur:
    MaterialCardView (root, bisa diklik)
        └── LinearLayout (horizontal)
                ├── ImageView  (poster film, 72×100dp)
                └── LinearLayout (vertikal)
                        ├── TextView  (judul film)
                        ├── TextView  (genre)
                        └── RatingBar (rating bintang)
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardMovie"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp"
    app:rippleColor="?attr/colorControlHighlight">

    <!--
        LinearLayout horizontal: poster di kiri, info film di kanan.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!--
            ImageView poster film.
            scaleType="centerCrop": gambar dipotong agar mengisi area tanpa distorsi.
            background diisi dengan placeholder warna abu-abu.
        -->
        <ImageView
            android:id="@+id/ivPoster"
            android:layout_width="72dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/poster_description"
            android:background="@color/poster_placeholder"
            android:src="@android:drawable/ic_menu_gallery" />

        <!--
            Kolom kanan: info film secara vertikal.
            layout_weight="1" agar mengisi sisa ruang setelah poster.
        -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical"
            android:gravity="center_vertical">

            <!-- Judul Film -->
            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurface"
                android:maxLines="2"
                android:ellipsize="end" />

            <!-- Genre / Kategori -->
            <TextView
                android:id="@+id/tvGenre"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <!--
                RatingBar untuk menampilkan rating secara visual.
                isIndicator="true": tidak bisa diubah oleh user (read-only).
                stepSize="0.5": mendukung setengah bintang.
            -->
            <RatingBar
                android:id="@+id/ratingBar"
                style="@style/Widget.AppCompat.RatingBar.Small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:numStars="5"
                android:stepSize="0.5"
                android:isIndicator="true" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
