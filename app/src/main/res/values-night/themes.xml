<?xml version="1.0" encoding="utf-8"?>
<!--
    themes.xml (values-night) — override tema untuk Dark Mode.
    Android otomatis memilih folder 'values-night' saat sistem dalam mode gelap.
-->
<resources>
    <!--
        Theme.App versi Dark Mode.
        Material3.DayNight sudah menangani warna surface/background otomatis,
        sehingga kita hanya perlu override warna yang ingin dikustomisasi.
    -->
    <style name="Theme.App" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Warna primer lebih terang agar kontras di background gelap -->
        <item name="colorPrimary">@color/purple_200</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/black</item>

        <!-- Warna sekunder -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_200</item>
        <item name="colorOnSecondary">@color/black</item>

        <!-- Status bar gelap mengikuti tema malam -->
        <item name="android:statusBarColor">?attr/colorPrimaryVariant</item>
    </style>
</resources>
